rules_version = '2';
// Safe default: deny all client access until owner-specific private rules are
// generated by scripts/prepare-cloud-config.mjs for the free deployment.
// Paste .cloud-local/firestore.rules in the new project's console after review.
// Existing projects require preserving their other applications' rules.
service cloud.firestore {
  match /databases/{database}/documents {
    // The API verifies the owner's Firebase ID token before using Admin SDK.
    // Browsers never read or write metadata directly.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
