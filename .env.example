# npm run dev is restricted to this computer's loopback address.
# npm start fails closed until Google owner authentication is configured.
APP_LOCAL_MODE=false
PORT=3001
# HTTPS origin only, with no trailing path. Local OAuth testing can use http://127.0.0.1:5173.
APP_URL=
OWNER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional legacy local-server OpenAI credential. The free deployment never uses this.
APP_AI_KEY=
APP_AI_MODEL=gpt-4.1-mini
# Production must use a persistent private disk; defaults to .data within checkout.
# APP_DATA_DIR=/data

# Netlify free deployment. These Firebase SDK values are public web-app settings.
# Leave them unset for the local development server.
# VITE_CLOUD_MODE=true
# VITE_DEPLOYMENT_MODE=free
# VITE_OWNER_EMAIL=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_APP_ID=
# Free server settings belong in Netlify environment variables, never VITE_ fields.
# APP_FIREBASE_PROJECT_ID=
# APP_FIREBASE_WEB_API_KEY=
# APP_DRIVE_ENABLED=false
# APP_AI_ENABLED=false
# APP_GEMINI_KEY=
# APP_GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_CLIENT_SECRET and optional APP_GEMINI_KEY must be entered securely in Netlify.
